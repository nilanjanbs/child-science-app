# ── Mahika English App — Environment Config ───────────────────
# Never commit this file to version control.

# Anthropic API key (required for AI question generation)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=<>

# Server port (optional, defaults to 3000)
# PORT=3000

# AI cooldown in minutes per module (optional, defaults to 10)
# AI_COOLDOWN_MINUTES=10

# Number of AI questions generated per request (optional, defaults to 5)
# AI_QUESTION_COUNT=5
